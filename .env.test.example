# Copy to .env.test at the repo root. Used only by
# `npm run test:integration -w @codeforge/api` — a disposable database, safe
# to migrate/seed/wipe, never the same one your real .env points at.
#
# Create it once:
#   docker compose exec postgres psql -U codeforge -c "CREATE DATABASE codeforge_test"
#   npm run db:deploy -w @codeforge/api   (after temporarily pointing DATABASE_URL below)
DATABASE_URL=postgresql://codeforge:codeforge@localhost:5433/codeforge_test
REDIS_URL=redis://localhost:6380
NODE_ENV=test
JWT_ACCESS_SECRET=test-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=test-refresh-secret-at-least-32-characters-long
WEB_ORIGIN=http://localhost:3000
