# ============================================================
# CodeForge environment configuration
# Copy to .env at the repo root (the API loads it via dotenv).
# Every value here is required unless marked optional.
# ============================================================

# --- Core ---
NODE_ENV=development
API_PORT=4000
# Origin of the Next.js app (CORS + links embedded in invitation emails)
WEB_ORIGIN=http://localhost:3000
# Origin of the API as seen from the Next.js server (used for /api rewrites)
API_ORIGIN=http://localhost:4000

# --- PostgreSQL ---
# docker-compose maps the app database to host port 5433 to avoid
# colliding with any locally installed Postgres.
DATABASE_URL=postgresql://codeforge:codeforge@localhost:5433/codeforge

# --- Redis (BullMQ job queue) ---
# docker-compose maps to host port 6380 for the same reason.
REDIS_URL=redis://localhost:6380

# --- Auth secrets ---
# Generate real values with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-change-me-access-secret
JWT_REFRESH_SECRET=dev-only-change-me-refresh-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Bootstrap admin (created by `npm run db:seed`) ---
SEED_ORG_NAME=CodeForge Demo Org
SEED_ADMIN_EMAIL=admin@codeforge.local
SEED_ADMIN_PASSWORD=admin1234!

# --- Code execution ---
# judge0 = production default (isolate sandbox, requires a cgroup-v1-capable
#          Linux kernel — see README "Judge0 on Windows").
# docker = local-dev fallback: runs code in ephemeral hardened containers on
#          the local Docker daemon (js/python/c/cpp/java). Dev only.
EXECUTOR=judge0
JUDGE0_URL=http://localhost:2358
# Optional: set if you enable authentication on your Judge0 instance
JUDGE0_AUTH_TOKEN=

# --- Email ---
# Phase 1 ships a "console" driver that logs invitation links instead of
# sending mail. Swap for Resend/Postmark/SES in Phase 4.
EMAIL_DRIVER=console
EMAIL_FROM=CodeForge <no-reply@codeforge.local>

# --- Object storage (MinIO; wired now, first used by Phase 2 proctoring) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=codeforge
S3_SECRET_KEY=codeforge-secret
S3_BUCKET=codeforge

# --- Workers ---
# true  = run the grading/auto-submit workers inside the API process (dev convenience)
# false = run them separately with `npm run dev:worker` (recommended for prod)
WORKER_INLINE=true
