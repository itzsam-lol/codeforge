{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeForge Sentinel",
  "version": "0.1.0",
  "identifier": "io.codeforge.sentinel",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CodeForge Sentinel",
        "width": 900,
        "height": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["codeforge-sentinel"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "CodeForge",
    "copyright": "Copyright © CodeForge",
    "shortDescription": "Lockdown proctoring companion for CodeForge assessments.",
    "longDescription": "CodeForge Sentinel runs alongside a proctored CodeForge test to enforce lockdown (fullscreen, blocked hotkeys, clipboard lockdown, capture protection) and to detect virtual machines, input-injection tooling, and prohibited applications. It only runs during a test session you've been invited to — it does not run in the background otherwise.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
