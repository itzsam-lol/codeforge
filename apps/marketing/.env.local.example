# Copy to .env.local (gitignored, never commit real secrets here).

# Server-side only, used by src/app/api/chat/route.ts. Get one at
# https://console.groq.com/keys. Never expose this to the browser.
GROQ_API_KEY=

# Public (safe to expose to the browser): your Spline "Code export" runtime
# URL, looks like https://prod.spline.design/<id>/scene.splinecode. The
# my.spline.design editor share link will NOT work here.
NEXT_PUBLIC_SPLINE_SCENE_URL=
