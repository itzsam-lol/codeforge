# Copy to .env.local (gitignored, never commit real secrets here).

# Public (safe to expose to the browser): the site's canonical production
# URL, used to build absolute URLs for metadata, Open Graph, robots.txt, and
# sitemap.xml. Defaults to https://codeforge.io (the domain already implied
# by support@codeforge.io) if unset.
NEXT_PUBLIC_SITE_URL=https://codeforge.io

# Server-side only, used by src/app/api/chat/route.ts. Get one at
# https://console.groq.com/keys. Never expose this to the browser.
GROQ_API_KEY=

# Public (safe to expose to the browser): your Spline "Code export" runtime
# URL, looks like https://prod.spline.design/<id>/scene.splinecode. The
# my.spline.design editor share link will NOT work here.
NEXT_PUBLIC_SPLINE_SCENE_URL=

# Server-side only, used by src/app/api/contact/route.ts (the "Book a demo" /
# "Contact sales" form). Without RESEND_API_KEY set, submissions are accepted
# and logged to the server console instead of emailed — fine for local dev.
RESEND_API_KEY=
EMAIL_FROM=CodeForge <onboarding@resend.dev>
# Where lead submissions get sent. Required for the form to actually notify
# anyone; without it, submissions are accepted but only logged (see above).
SALES_NOTIFY_EMAIL=

# Optional: dual-writes every submission into CodeForge HQ's lead inbox
# (apps/hq-api) instead of email being the only record. Both must be set for
# this to activate; leave blank in local dev if you aren't running HQ.
HQ_API_URL=
HQ_INGEST_SECRET=
