// CodeForge data model: Section 7 of the spec, in full.
// Every entity is scoped to an Organization (directly or via a FK chain) so
// multi-tenancy can be added later without a rewrite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (lowercase values match the string unions in @codeforge/shared)
// ---------------------------------------------------------------------------

enum Role {
  super_admin
  recruiter
  reviewer
}

enum QuestionType {
  dsa
  mcq
  frontend_ui
  bug_fix
  api_challenge
  repo_project
}

enum Difficulty {
  easy
  medium
  hard
}

enum TestStatus {
  draft
  published
  closed
  archived
}

enum InvitationStatus {
  pending
  opened
  started
  completed
  expired
  revoked
}

enum SessionStatus {
  created
  in_progress
  submitted
  auto_submitted
  expired
}

enum SubmissionKind {
  run
  submit
}

enum SubmissionStatus {
  queued
  running
  graded
  failed
}

enum ProctoringLevel {
  none
  basic
  strict
  lockdown
}

// ---------------------------------------------------------------------------
// Core entities
// ---------------------------------------------------------------------------

model Organization {
  id             String   @id @default(cuid())
  name           String
  // { logoUrl?, accentColor?, displayName? }: shown on candidate-facing pages.
  brandingConfig Json     @default("{}")
  createdAt      DateTime @default(now())

  users          User[]
  questions      Question[]
  tests          Test[]
  auditLogs      AuditLog[]
  supportTickets SupportTicket[]
  notifications  Notification[]
}

/**
 * Org-wide, not per-user: any staff member sees the same feed (small-team
 * product, matches how the existing audit log and activity views already
 * work — nobody has a private inbox). Fed by existing alert-worthy moments
 * (new support ticket, a reply arriving) rather than new business logic.
 */
model Notification {
  id        String    @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([orgId, readAt])
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  role         Role
  // Empty = unrestricted within `role` (today's behavior, every existing
  // account keeps working unchanged). Non-empty = an explicit allow-list of
  // capability keys (see PERMISSIONS in @codeforge/shared), for an employee
  // scoped down to e.g. only the question bank. Checked by requirePermission
  // in apps/api/src/middleware/auth.ts, additive to (not instead of) the
  // existing role-tier checks.
  permissions  String[] @default([])
  // false = legacy account, an empty `permissions` array still means
  // unrestricted (backfilled false for every account that existed before
  // this field). true = explicit semantics: an empty array means no
  // permissions at all. Set true on every account created from here on,
  // and flipped true the moment an admin explicitly edits an existing
  // user's permissions — see apps/api/src/routes/user.routes.ts.
  permissionsExplicit Boolean @default(true)
  isActive     Boolean  @default(true)
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Per-account brute-force lockout on /login (independent of the IP-keyed
  // authLimiter, which alone doesn't slow a distributed credential-stuffing
  // attempt against one email). Reset to 0/null on a successful login.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // TOTP secret is AES-256-GCM encrypted at rest (lib/crypto.ts), never
  // returned by any API response. enabledAt null = enrollment not
  // completed (a secret can exist mid-enrollment before the first
  // successful verify); backupCodes are bcrypt-hashed, one-time use.
  twoFactorSecret       String?
  twoFactorEnabledAt    DateTime?
  twoFactorBackupCodes  String[] @default([])

  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  twoFactorChallenges  TwoFactorChallenge[]
  questionsCreated     Question[]
  testsCreated         Test[]
  reviewNotes          ReviewNote[]
  sessionNotes         SessionNote[]
  auditLogs            AuditLog[]
  supportTicketsOpened   SupportTicket[]  @relation("SupportTicketOpenedBy")
  supportTicketsAssigned SupportTicket[]  @relation("SupportTicketAssignedTo")
  supportMessages        SupportMessage[]

  @@index([orgId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  userAgent  String?
  ipAddress  String?

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/**
 * Bridges the two-step login flow: password check succeeds but no tokens
 * are issued yet, this row (and its opaque token, handed to the client)
 * identifies which user is mid-challenge until a valid TOTP/backup code
 * arrives at POST /auth/2fa/verify. Single-use (consumed on success),
 * 5-minute TTL — deliberately much shorter than a password-reset link.
 */
model TwoFactorChallenge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Question bank
// ---------------------------------------------------------------------------

model Question {
  id               String       @id @default(cuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id])
  type             QuestionType
  title            String
  bodyMd           String
  // Type-specific fields (validated against the zod schemas in @codeforge/shared)
  typeConfig       Json         @default("{}")
  difficulty       Difficulty
  tags             String[]     @default([])
  estimatedMinutes Int?
  // Weighted scoring breakdown, e.g. 80% automated + 20% manual (rubricSchema)
  rubric           Json?
  // Versioning: editing a question that already has submissions creates a new
  // row; the old row points at its replacement and stays for historical results.
  version          Int          @default(1)
  rootId           String?
  supersededById   String?
  isShared         Boolean      @default(false)
  isArchived       Boolean      @default(false)
  createdById      String
  createdBy        User         @relation(fields: [createdById], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  testCases     TestCase[]
  testQuestions TestQuestion[]
  submissions   Submission[]

  @@index([orgId, type, isArchived])
  @@index([orgId, supersededById])
}

model TestCase {
  id             String   @id @default(cuid())
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  input          String
  expectedOutput String
  isHidden       Boolean  @default(true)
  weight         Float    @default(1)
  orderIndex     Int      @default(0)

  judgeResults JudgeResult[]

  @@index([questionId])
}

// ---------------------------------------------------------------------------
// Tests (assessments)
// ---------------------------------------------------------------------------

model Test {
  id              String          @id @default(cuid())
  orgId           String
  org             Organization    @relation(fields: [orgId], references: [id])
  title           String
  description     String          @default("")
  durationMinutes Int
  // testSettingsSchema in @codeforge/shared (shuffle, partial credit, languages,
  // instructions markdown, proctoring thresholds, ...)
  settings        Json            @default("{}")
  proctoringLevel ProctoringLevel @default(none)
  schedulingStart DateTime?
  schedulingEnd   DateTime?
  status          TestStatus      @default(draft)
  createdById     String
  createdBy       User            @relation(fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  // Set once, the first time every invitation reaches a terminal state, so the
  // "results ready" recruiter email fires exactly once per test.
  resultsNotifiedAt DateTime?

  questions   TestQuestion[]
  pools       QuestionPool[]
  invitations Invitation[]
  sessions    TestSession[]

  @@index([orgId, status])
}

// A slot in a test: either a fixed question or a pool it draws from per candidate.
model TestQuestion {
  id         String        @id @default(cuid())
  testId     String
  test       Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionId String?
  question   Question?     @relation(fields: [questionId], references: [id])
  poolId     String?
  pool       QuestionPool? @relation(fields: [poolId], references: [id])
  orderIndex Int
  points     Float         @default(10)

  @@index([testId, orderIndex])
}

// Interchangeable difficulty-equivalent questions for one slot (Section 3.3).
model QuestionPool {
  id          String   @id @default(cuid())
  testId      String
  test        Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  name        String
  questionIds String[] @default([])

  testQuestions TestQuestion[]

  @@index([testId])
}

// ---------------------------------------------------------------------------
// Invitations & sessions
// ---------------------------------------------------------------------------

model Invitation {
  id             String           @id @default(cuid())
  testId         String
  test           Test             @relation(fields: [testId], references: [id], onDelete: Cascade)
  candidateEmail String
  candidateName  String
  // Opaque 256-bit random capability token embedded in the emailed link —
  // this is the candidate's live session credential (`x-candidate-token`
  // on every request throughout the test), so it can't be hashed-and-
  // rotated once a session has started.
  //
  // Legacy rows created before hashing was added still have `token` set
  // (raw, at rest) and keep working via that column — unmigrated on
  // purpose rather than force-rotating live candidate links. Every
  // invitation created going forward sets only `tokenHash` (SHA-256) and
  // leaves `token` null; the raw value is returned once, at creation (and
  // again on /:id/resend), and never persisted. See requireCandidate in
  // middleware/candidate.ts for the OR-matched lookup across both.
  token          String?          @unique
  tokenHash      String?          @unique
  expiresAt      DateTime
  status         InvitationStatus @default(pending)
  // Identity-confirmation mismatches; the link locks after 5 (Section 3.1).
  failedAttempts Int              @default(0)
  // Set once a 24h-before-expiry reminder email has gone out, so the sweep
  // job never sends a second one.
  remindedAt     DateTime?
  createdAt      DateTime         @default(now())
  // A recruiter's own "preview as candidate" run (POST /tests/:id/preview),
  // not a real candidate. Excluded from invitation counts, results,
  // analytics, and the "results ready" recruiter notification — see every
  // isPreview: false filter alongside those queries.
  isPreview      Boolean          @default(false)
  // Accommodation: e.g. 150 = 1.5x the test's normal duration. Null = no
  // adjustment. Applied once, at /start (apps/api/src/routes/candidate.routes.ts).
  durationMultiplierPct Int?

  session TestSession?

  @@index([testId, status])
  @@index([testId, isPreview])
  @@unique([testId, candidateEmail])
}

model TestSession {
  id                String        @id @default(cuid())
  invitationId      String        @unique
  invitation        Invitation    @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  testId            String
  test              Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  candidateName     String
  candidateEmail    String
  startedAt         DateTime?
  // Server-authoritative deadline; the auto-submit job fires on this.
  endsAt            DateTime?
  submittedAt       DateTime?
  status            SessionStatus @default(created)
  currentQuestionId String?
  // Per-candidate resolved question list: [{questionId, points, order}]
  // (captures shuffle + pool picks so grading is reproducible)
  questionOrder     Json?
  integrityScore    Int?
  ipAddress         String?
  userAgent         String?
  // Recruiter dashboard triage (spec 3.8 bulk actions): starred + free-form tags.
  shortlisted       Boolean       @default(false)
  tags              String[]      @default([])
  // Mirrors Invitation.isPreview (same recruiter preview run).
  isPreview         Boolean       @default(false)
  // Set on every POST /candidate/sentinel-heartbeat. Null = this session
  // never used CodeForge Sentinel (a plain browser-only session) — the
  // heartbeat-sweep job (services/sentinel.ts) only flags sessions where
  // this is non-null but stale, never a session that was always
  // browser-only.
  sentinelLastHeartbeatAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  submissions      Submission[]
  drafts           AnswerDraft[]
  proctoringEvents ProctoringEvent[]
  reviewNotes      ReviewNote[]
  sessionNotes     SessionNote[]
  editorEvents     EditorEventBatch[]
  supportTickets   SupportTicket[]

  @@index([testId, status])
  @@index([status, endsAt])
  @@index([testId, status, isPreview])
}

// Server-side autosave state: the source of truth for in-progress answers.
model AnswerDraft {
  id         String   @id @default(cuid())
  sessionId  String
  session    TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String
  // Code for coding questions; JSON {"selectedOptionIds": [...]} for MCQ.
  content    String
  language   String?
  updatedAt  DateTime @updatedAt

  @@unique([sessionId, questionId])
}

// ---------------------------------------------------------------------------
// Submissions & grading
// ---------------------------------------------------------------------------

model Submission {
  id           String           @id @default(cuid())
  sessionId    String
  session      TestSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question         @relation(fields: [questionId], references: [id])
  kind         SubmissionKind   @default(submit)
  content      String
  language     String?
  version      Int              @default(1)
  // The submission that counts toward the session score (latest at finalize).
  isFinal      Boolean          @default(false)
  status       SubmissionStatus @default(queued)
  autoScore    Float?
  manualScore  Float?
  maxPoints    Float            @default(0)
  errorMessage String?
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?

  judgeResults          JudgeResult[]
  plagiarismReports     PlagiarismReport[] @relation("PlagSource")
  plagiarismComparisons PlagiarismReport[] @relation("PlagTarget")

  @@index([sessionId, questionId])
  @@index([questionId, kind])
}

model JudgeResult {
  id            String     @id @default(cuid())
  submissionId  String
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCaseId    String?
  testCase      TestCase?  @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  judge0Token   String?
  verdict       String
  passed        Boolean    @default(false)
  stdout        String?
  stderr        String?
  compileOutput String?
  timeMs        Int?
  memoryKb      Int?
  // Phase 3: type-specific detail, visual-diff screenshot keys + similarity,
  // assertion labels, HTTP test detail, repo step names, git metadata, ...
  metadata      Json?
  createdAt     DateTime   @default(now())

  @@index([submissionId])
}

// ---------------------------------------------------------------------------
// Integrity layer (Phase 2 writes these; schema ships now)
// ---------------------------------------------------------------------------

model ProctoringEvent {
  id        String      @id @default(cuid())
  sessionId String
  session   TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType String
  severity  Int         @default(1)
  metadata  Json        @default("{}")
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

model PlagiarismReport {
  id                   String      @id @default(cuid())
  submissionId         String
  submission           Submission  @relation("PlagSource", fields: [submissionId], references: [id], onDelete: Cascade)
  // Null for reference-corpus matches (kind = "reference")
  comparedSubmissionId String?
  comparedSubmission   Submission? @relation("PlagTarget", fields: [comparedSubmissionId], references: [id], onDelete: Cascade)
  // "candidate" = candidate-to-candidate collusion signal;
  // "reference" = similarity to a known public/reference solution.
  kind                 String      @default("candidate")
  referenceLabel       String?
  similarityPct        Float
  // [{aStart,aEnd,bStart,bEnd}] char offsets for the side-by-side diff view
  matchedRanges        Json        @default("[]")
  createdAt            DateTime    @default(now())

  @@index([submissionId])
  @@index([comparedSubmissionId])
}

// Keystroke-level session replay (spec 3.5): batches of Monaco content deltas
// {t, o, d, i} = ms-since-start, offset, deleted count, inserted text.
model EditorEventBatch {
  id         String      @id @default(cuid())
  sessionId  String
  session    TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String
  seq        Int
  ops        Json
  createdAt  DateTime    @default(now())

  @@index([sessionId, questionId, seq])
}

model ReviewNote {
  id           String      @id @default(cuid())
  sessionId    String
  session      TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User        @relation(fields: [reviewerId], references: [id])
  rubricScores Json        @default("{}")
  note         String      @default("")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([sessionId, reviewerId])
  @@index([sessionId])
}

// Freeform recruiter-team timeline on a candidate's session — distinct from
// ReviewNote above (one row per reviewer, tied to rubric scoring): this is
// an unbounded append-only log, any staff member, any number of entries,
// same shape as apps/hq-api's ClientActivity.
model SessionNote {
  id        String      @id @default(cuid())
  sessionId String
  session   TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  authorId  String
  author    User        @relation(fields: [authorId], references: [id])
  body      String      @db.Text
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

// ---------------------------------------------------------------------------
// Observability (Phase 5): who did what, for review after the fact.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id])
  actorId    String
  actor      User         @relation(fields: [actorId], references: [id])
  // e.g. "score.override", "invitation.revoke", "org.branding.update"
  action     String
  targetType String
  targetId   String
  metadata   Json         @default("{}")
  createdAt  DateTime     @default(now())

  @@index([orgId, createdAt])
}

// ---------------------------------------------------------------------------
// Support tickets. Two independent channels sharing one shape:
// - "org": candidate <-> this org's own recruiters. Fully local, no
//   cross-service dependency at all.
// - "codeforge": routed to CodeForge HQ (apps/hq-api has its own copy of
//   this same shape, scoped to clientId instead of orgId). This org's copy
//   here is always the source of truth for what THIS org/candidate sees;
//   apps/hq-api is dual-written to best-effort (see services/support.ts) so
//   a sync failure never blocks ticket creation or replies on this side.
// ---------------------------------------------------------------------------

enum SupportTicketChannel {
  org
  codeforge
}

enum SupportTicketStatus {
  open
  pending
  resolved
  closed
}

enum SupportTicketPriority {
  normal
  urgent
}

model SupportTicket {
  id       String               @id @default(cuid())
  orgId    String
  org      Organization         @relation(fields: [orgId], references: [id])
  channel  SupportTicketChannel
  status   SupportTicketStatus  @default(open)
  priority SupportTicketPriority @default(normal)
  subject  String

  // Candidate-opened tickets: session may be null if opened before a
  // session exists yet (landing phase) or if the session/invitation was
  // later deleted — candidateEmail/candidateName are always captured
  // directly so the ticket and its email fallback never depend on the
  // session row surviving.
  candidateSessionId String?
  candidateSession   TestSession? @relation(fields: [candidateSessionId], references: [id], onDelete: SetNull)
  candidateEmail     String?
  candidateName      String?

  // Staff-opened tickets (e.g. a recruiter filing a codeforge-channel bug
  // report directly, not via a candidate).
  openedByUserId String?
  openedByUser   User?   @relation("SupportTicketOpenedBy", fields: [openedByUserId], references: [id])

  assignedToUserId String?
  assignedToUser   User?   @relation("SupportTicketAssignedTo", fields: [assignedToUserId], references: [id])

  // Opaque id of the mirrored row in apps/hq-api's own SupportTicket table,
  // once the dual-write succeeds (null until then, or if it never does —
  // the ticket is still fully usable on this side regardless).
  hqTicketId String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  messages SupportMessage[]

  @@index([orgId, status])
  @@index([candidateSessionId])
}

model SupportMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // "candidate" | "staff" | "codeforge" | "system" — kept as a plain string
  // rather than an enum since "codeforge" messages arrive from a different
  // service's user model entirely (no local User row to point at).
  authorType String
  authorId   String?
  author     User?   @relation(fields: [authorId], references: [id])
  authorName String

  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// CodeForge Arena (public competitive-coding product, apps/marketing
// frontend). Fully independent auth from Organization User / candidate
// invitation tokens / HQ staff — see middleware/arenaAuth.ts. Shares this
// database and Judge0 infra with the core product; owns no Organization FK.
// Contest content is authored in apps/hq-api's separate database and pushed
// here (see routes/arenaContestSync.routes.ts) — ArenaContestCache is the
// landing spot, cached rather than normalized so a live contest keeps
// working even if HQ is briefly unreachable.
// ---------------------------------------------------------------------------

enum ArenaOAuthProvider {
  google
  github
}

enum ArenaParticipationStatus {
  registered
  active
  submitted
  // Crossed the contest's maxStrikes proctoring-violation threshold (BUG-6)
  // — a visible flag for staff review, not itself a hard block on
  // submitting; disqualified (2x maxStrikes) is the hard block.
  warned
  disqualified
}

enum ArenaSubmissionMode {
  contest
  practice
}

enum ArenaDifficulty {
  easy
  medium
  hard
}

model ArenaUser {
  id           String  @id @default(cuid())
  email        String  @unique
  // Null for OAuth-only accounts — login route must check this is non-null
  // before attempting bcrypt.compare.
  passwordHash String?
  name         String
  // Public profile slug: /arena/profile/:handle
  handle       String  @unique
  avatarUrl    String?
  bio          String  @default("")
  country      String?

  rating          Int       @default(1200)
  ratingUpdatedAt DateTime?

  emailVerifiedAt DateTime?
  // Mirrors User.failedLoginAttempts/lockedUntil exactly — see that
  // model's comment for the rationale.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  oauthAccounts  ArenaOAuthAccount[]
  refreshTokens  ArenaRefreshToken[]
  participations ArenaParticipation[]
  submissions    ArenaSubmission[]
  userBadges     ArenaUserBadge[]
  activity       ArenaActivity[]

  @@index([rating])
}

model ArenaRefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      ArenaUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model ArenaOAuthAccount {
  id             String             @id @default(cuid())
  userId         String
  user           ArenaUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       ArenaOAuthProvider
  providerUserId String
  // Provider tokens are NOT stored: OAuth here is login-identity only (no
  // ongoing calls to Google/GitHub APIs after sign-in), so there is nothing
  // to encrypt at rest.
  createdAt      DateTime           @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

// Cache of hq-api's Contest + ContestQuestion rows, pushed by the sync (see
// routes/arenaContestSync.routes.ts). No cross-database FK is possible
// (separate Postgres instances) — contestId here is hq-api's Contest.id,
// copied verbatim.
model ArenaContestCache {
  contestId String   @id
  payload   Json
  // Denormalized top-level fields for fast lookups without unpacking payload
  // on every request — status for `WHERE status = 'live'` list queries,
  // slug for loadContestOr404 (routes/arenaContests.routes.ts), which used
  // to load every cached contest into memory to find one by slug.
  status    String
  slug      String   @unique
  startAt   DateTime
  endAt     DateTime
  syncedAt  DateTime @default(now())
}

// Live-contest staff announcements (BUG-7's broadcast system). apps/api is
// the sole source of truth here, same as everything else a candidate reads
// during a contest — hq-api's POST proxies straight through (mirrors the
// existing review-decision proxy) rather than keeping its own copy.
model ArenaBroadcast {
  id        String   @id @default(cuid())
  contestId String
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([contestId, createdAt])
}

model ArenaParticipation {
  id     String @id @default(cuid())
  userId String
  user   ArenaUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  // hq-api Contest.id — no FK, see banner comment above.
  contestId String

  status       ArenaParticipationStatus @default(registered)
  score        Float                    @default(0)
  // icpc_penalty scoring mode only.
  penaltyMs    BigInt                   @default(0)
  rank         Int?
  registeredAt DateTime                 @default(now())
  finishedAt   DateTime?

  // Denormalized snapshot of the rating delta this contest produced, so a
  // completed contest's leaderboard can still show "+42" next to a user
  // even after ArenaUser.rating has moved on from later contests.
  ratingBefore Int?
  ratingAfter  Int?

  // Proctor-to-Earn (routes/arenaContests.routes.ts's /proctoring-level,
  // services/arenaRating.ts): "none" | "webcam" | "lockdown", locked in at
  // first submission. ratingMultiplier is derived from the contest's
  // webcamBonusPct/lockdownBonusPct at the moment the level is chosen and
  // stored here (not recomputed from the level string later) so a staff
  // member changing the contest's bonus config mid-contest never silently
  // changes an already-committed participant's stakes.
  chosenProctoringLevel String @default("none")
  ratingMultiplier       Float  @default(1)
  // True the instant the participant makes ANY choice via /proctoring-level,
  // including explicitly picking "none" (Casual) — chosenProctoringLevel
  // alone can't distinguish "chose Casual" from "hasn't chosen yet" since
  // both read as "none" (see the compete page's lobbyDone logic, BUG-4).
  proctoringLevelChosen Boolean @default(false)

  // AI proctoring review (services/arenaVision.ts, HQ's review page):
  // append-only [{severity, reason, confidence, snapshotKey, createdAt}].
  aiFlags      Json   @default("[]")
  reviewStatus String @default("pending") // "pending" | "clean" | "cheating_confirmed"

  // Server-side proctoring event pipeline (routes/arenaContests.routes.ts's
  // POST .../proctoring-events, BUG-6) — client-detected tab-switch/blur/
  // fullscreen-exit/copy-paste events, permanently recorded instead of only
  // living in React state. strikeCount is a denormalized running total
  // (each event type is worth 1 or 2 strikes) so the strike-threshold check
  // and the compete page's warning banner don't need to replay the whole
  // proctoringEvents array on every request.
  proctoringEvents Json @default("[]")
  strikeCount      Int  @default(0)

  submissions ArenaSubmission[]

  @@unique([userId, contestId])
  @@index([contestId, score])
}

// Practice problems are authored directly in apps/api (unlike contests,
// authored in hq-api) — no staff-review workflow requested for these in
// scope.
model ArenaPracticeProblem {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  bodyMd      String          @db.Text
  difficulty  ArenaDifficulty
  tags        String[]        @default([])
  // Same typeConfig-blob convention as hq-api's ContestQuestion.
  typeConfig  Json            @default("{}")
  isPublished Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  submissions ArenaSubmission[]
}

model ArenaSubmission {
  id     String              @id @default(cuid())
  userId String
  user   ArenaUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode   ArenaSubmissionMode

  // Set iff mode=contest (hq-api ids, no FK — see banner comment above);
  // null iff mode=practice, where practiceProblemId is set instead.
  contestId         String?
  participationId   String?
  participation     ArenaParticipation?   @relation(fields: [participationId], references: [id], onDelete: Cascade)
  contestQuestionId String?
  practiceProblemId String?
  practiceProblem   ArenaPracticeProblem? @relation(fields: [practiceProblemId], references: [id])

  // Coding submissions only; null for mcq (selectedOptionIds is set instead).
  language String?
  code     String? @db.Text
  // mcq submissions only.
  selectedOptionIds String[] @default([])
  // "pending" | "accepted" | "wrong_answer" | "runtime_error" | "tle" | "compile_error"
  // — mirrors Submission.status's plain-string convention.
  status      String
  score       Float    @default(0)
  judge0Meta  Json     @default("{}")
  submittedAt DateTime @default(now())

  @@index([userId, mode])
  @@index([contestId, contestQuestionId])
  @@index([practiceProblemId])
}

model ArenaBadge {
  id          String   @id @default(cuid())
  // e.g. "first_blood" | "streak_7" | "top_10_finish"
  key         String   @unique
  name        String
  description String
  // Maps to a marketing-side icon component, not a stored image.
  iconKey     String
  createdAt   DateTime @default(now())

  userBadges ArenaUserBadge[]
}

model ArenaUserBadge {
  id        String     @id @default(cuid())
  userId    String
  user      ArenaUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     ArenaBadge @relation(fields: [badgeId], references: [id])
  awardedAt DateTime   @default(now())
  // Denormalized context for the profile page timeline, e.g. "Earned in
  // Weekly Contest #12", without a lookup into hq-api.
  contextLabel String?

  @@unique([userId, badgeId])
}

// Lightweight public activity feed for profile pages ("solved Two Sum",
// "placed #4 in Weekly Contest #9") — append-only, same shape precedent as
// SessionNote.
model ArenaActivity {
  id        String    @id @default(cuid())
  userId    String
  user      ArenaUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "submission_accepted" | "contest_finished" | "badge_earned" | "rating_change"
  type      String
  metadata  Json      @default("{}")
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}
