// CodeForge HQ: the internal ops platform CodeForge's own team uses to
// manage staff, the client/lead pipeline, and provisioning of new
// self-hosted client deployments. Fully separate database and auth
// boundary from the per-client product schema in apps/api — HQ has exactly
// one tenant (CodeForge itself), so there is no orgId scoping here.

// Custom output path (not the default node_modules/@prisma/client): apps/api
// and apps/hq-api each have their own Prisma schema, but npm workspaces
// hoist node_modules/@prisma/client to one shared location — generating
// both schemas' clients there would have each overwrite the other's types.
// Isolating this one to its own generated folder avoids that collision.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("HQ_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Staff auth
// ---------------------------------------------------------------------------

enum HqRole {
  owner
  staff
}

model HqStaff {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         HqRole   @default(staff)
  // Capability catalog (HQ_PERMISSIONS in @codeforge/shared). Empty array =
  // unrestricted within role, same additive design as the client product's
  // User.permissions (see apps/api/prisma/schema.prisma).
  permissions  String[] @default([])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Mirrors apps/api's User.failedLoginAttempts/lockedUntil exactly — see
  // that schema's comment for the rationale.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Mirrors apps/api's User.twoFactor* fields exactly — see that schema's
  // comment for the encryption/enrollment/backup-code rationale.
  twoFactorSecret      String?
  twoFactorEnabledAt   DateTime?
  twoFactorBackupCodes String[] @default([])

  refreshTokens        HqRefreshToken[]
  passwordResetTokens  HqPasswordResetToken[]
  twoFactorChallenges  HqTwoFactorChallenge[]
  clientActivities     ClientActivity[]
  supportTicketsAssigned SupportTicket[]  @relation("SupportTicketAssignedTo")
  supportMessages        SupportMessage[]
  auditLogs              HqAuditLog[]
  contests               Contest[]

  @@map("hq_staff")
}

/**
 * Sensitive-action audit trail, mirroring apps/api's AuditLog exactly (see
 * that schema's comment). No orgId/tenant scoping — HQ is a single internal
 * console where every staff member can see every client, so this is a flat
 * log of who did what, not a per-tenant one.
 */
model HqAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      HqStaff  @relation(fields: [actorId], references: [id])
  // e.g. "staff.permissions.update", "provisioning.target.save", "invoice.create"
  action     String
  targetType String
  targetId   String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model HqRefreshToken {
  id         String    @id @default(cuid())
  staffId    String
  staff      HqStaff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  userAgent  String?
  ipAddress  String?

  @@index([staffId])
  @@map("hq_refresh_token")
}

model HqPasswordResetToken {
  id        String    @id @default(cuid())
  staffId   String
  staff     HqStaff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([staffId])
  @@map("hq_password_reset_token")
}

/** Mirrors apps/api's TwoFactorChallenge exactly — see that model's comment. */
model HqTwoFactorChallenge {
  id        String   @id @default(cuid())
  staffId   String
  staff     HqStaff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([staffId])
  @@map("hq_two_factor_challenge")
}

/** Global, not per-staff — small internal team, one shared feed. Fed by the
 *  same moments that already fire email/Slack alerts (lib/alerts.ts). */
model HqNotification {
  id        String    @id @default(cuid())
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("hq_notification")
}

// ---------------------------------------------------------------------------
// Client CRM
// ---------------------------------------------------------------------------

enum ClientStatus {
  lead
  trial
  live
  churned
}

model Client {
  id                String       @id @default(cuid())
  companyName       String
  contactName       String
  contactEmail      String
  contactPhone      String?
  status            ClientStatus @default(lead)
  appDomain         String?
  mediaDomain       String?
  contractStartDate DateTime?
  contractEndDate   DateTime?
  // Record-keeping only (Phase 3 billing tracking) — nothing here initiates
  // or processes a real payment; amounts/status reflect what was already
  // invoiced/collected elsewhere.
  mrrCents          Int?
  nextRenewalDate   DateTime?
  // Set when the renewal-reminder job (services/renewalReminder.ts) last
  // alerted HQ staff about this client's upcoming renewal. Compared against
  // nextRenewalDate (not just "is it set") so pushing the renewal date out
  // re-arms the reminder for the new date instead of staying silent forever.
  renewalReminderSentAt DateTime?
  notes             String?      @db.Text
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  activities          ClientActivity[]
  leads                Lead[]
  provisioningTarget   ProvisioningTarget?
  invoices             Invoice[]
  supportTickets       SupportTicket[]

  @@index([status])
  @@index([nextRenewalDate])
  @@index([updatedAt])
  @@map("client")
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
}

model Invoice {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amountCents Int
  status      InvoiceStatus @default(draft)
  dueDate     DateTime?
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime      @default(now())

  @@index([clientId])
  @@map("invoice")
}

enum ActivityType {
  note
  status_change
  system
}

model ClientActivity {
  id        String       @id @default(cuid())
  clientId  String
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String?
  author    HqStaff?     @relation(fields: [authorId], references: [id])
  type      ActivityType @default(note)
  body      String       @db.Text
  createdAt DateTime     @default(now())

  @@index([clientId])
  @@map("client_activity")
}

// ---------------------------------------------------------------------------
// Marketing leads
// ---------------------------------------------------------------------------

enum LeadIntent {
  demo
  sales
}

enum LeadStatus {
  new
  contacted
  qualified
  converted
  dismissed
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  company   String
  teamSize  String?
  focus     String?
  message   String?    @db.Text
  intent    LeadIntent
  status    LeadStatus @default(new)
  clientId  String?
  client    Client?    @relation(fields: [clientId], references: [id])
  createdAt DateTime   @default(now())

  @@index([status])
  @@map("lead")
}

// ---------------------------------------------------------------------------
// Provisioning
// ---------------------------------------------------------------------------

model ProvisioningTarget {
  id                String   @id @default(cuid())
  clientId          String   @unique
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  host              String
  sshPort           Int      @default(22)
  sshUsername       String
  // AES-256-GCM ciphertext (base64: iv + authTag + data), never returned by
  // any API response. Decrypted in-memory only for the duration of a run.
  sshPrivateKeyEnc  String   @db.Text
  sshKeyFingerprint String
  repoUrl           String   @default("https://github.com/itzsam-lol/codeforge.git")
  appDomain         String
  mediaDomain       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  runs            ProvisioningRun[]
  healthCheckLogs HealthCheckLog[]

  @@map("provisioning_target")
}

model HealthCheckLog {
  id        String             @id @default(cuid())
  targetId  String
  target    ProvisioningTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  healthy   Boolean
  latencyMs Int?
  detail    String?
  checkedAt DateTime           @default(now())

  @@index([targetId, checkedAt])
  @@map("health_check_log")
}

enum RunStatus {
  queued
  running
  succeeded
  failed
}

model ProvisioningRun {
  id           String    @id @default(cuid())
  targetId     String
  target       ProvisioningTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  status       RunStatus @default(queued)
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())

  steps ProvisioningStep[]

  @@index([targetId])
  @@map("provisioning_run")
}

enum StepStatus {
  pending
  running
  succeeded
  failed
}

model ProvisioningStep {
  id         String     @id @default(cuid())
  runId      String
  run        ProvisioningRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq        Int
  name       String
  status     StepStatus @default(pending)
  // Tail of captured stdout/stderr for this step, truncated to a reasonable
  // size at write time so a chatty command (docker compose build) can't
  // grow a row unboundedly.
  output     String?    @db.Text
  startedAt  DateTime?
  finishedAt DateTime?

  @@unique([runId, seq])
  @@map("provisioning_step")
}

// ---------------------------------------------------------------------------
// Support tickets (codeforge channel only — the HQ side of the two-sided
// support system). This is the mirror of apps/api's SupportTicket for
// channel="codeforge": apps/api dual-writes here via POST
// /api/support-tickets/ingest so HQ staff can see and respond to
// client-reported technical issues. This table is the source of truth for
// what HQ staff see; a write here never depends on apps/api being
// reachable (candidates/recruiters never write here directly).
// ---------------------------------------------------------------------------

enum SupportTicketStatus {
  open
  pending
  resolved
  closed
}

enum SupportTicketPriority {
  normal
  urgent
}

model SupportTicket {
  id       String                @id @default(cuid())
  clientId String
  client   Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status   SupportTicketStatus   @default(open)
  priority SupportTicketPriority @default(normal)
  subject  String

  // Opaque reference back to the originating apps/api SupportTicket row, so
  // a reply POSTed back (see routes/support.routes.ts) targets the right
  // ticket on that side. Unique: one HQ ticket per originating product-side
  // ticket.
  originTicketId String @unique
  // Base URL of the client deployment that created this ticket (their own
  // WEB_ORIGIN — /api/* is proxied to their API, same as candidate invite
  // links). Captured directly from the ingest payload rather than looked up
  // via Client.provisioningTarget, so a reply never depends on that
  // relationship existing or staying in sync.
  originApiUrl   String
  candidateEmail String?
  candidateName  String?

  assignedToStaffId String?
  assignedToStaff   HqStaff? @relation("SupportTicketAssignedTo", fields: [assignedToStaffId], references: [id])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  messages SupportMessage[]

  @@index([clientId, status])
  @@map("support_ticket")
}

model SupportMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // "candidate" | "staff" | "codeforge" | "system" — see apps/api's
  // SupportMessage for why this stays a plain string.
  authorType String
  authorId   String?
  author     HqStaff? @relation(fields: [authorId], references: [id])
  authorName String

  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("support_message")
}

// ---------------------------------------------------------------------------
// CodeForge Arena: contest authoring. HQ is the sole authority for contest
// content and lifecycle — apps/api (a separate database/service) only ever
// receives a push of this data (see apps/api/src/routes/arenaContestSync.routes.ts)
// and never writes back here except the final results snapshot below. No FK
// from these models into apps/api's ArenaUser/ArenaParticipation/etc: they
// live in a different Postgres instance entirely, linked only by copying
// this Contest's cuid verbatim as apps/api's ArenaParticipation.contestId.
// ---------------------------------------------------------------------------

enum ContestStatus {
  draft
  scheduled
  live
  grading
  completed
  cancelled
}

enum ArenaDifficulty {
  easy
  medium
  hard
}

enum ArenaProctoringLevel {
  none
  basic
  strict
  lockdown
}

enum ContestScoringMode {
  points
  icpc_penalty
}

enum ContestSyncStatus {
  idle
  pending
  synced
  failed
}

enum ArenaQuestionType {
  coding
  mcq
}

model Contest {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String        @default("") @db.Text
  status      ContestStatus @default(draft)

  scoringMode        ContestScoringMode   @default(points)
  proctoringLevel    ArenaProctoringLevel @default(basic)
  webcamRequired     Boolean              @default(false)
  fullscreenRequired Boolean              @default(true)

  // Proctor-to-Earn: rating-gain multiplier bonus applied on top of 1.0 for
  // a participant who chose that proctoring level for this contest (see
  // apps/api's ArenaParticipation.ratingMultiplier/arenaRating.ts). e.g. 15
  // = webcam participants earn/lose 15% more rating than an unproctored
  // participant with the same relative performance.
  webcamBonusPct   Float @default(15)
  lockdownBonusPct Float @default(35)

  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  startAt              DateTime
  endAt                DateTime

  isPublic Boolean @default(true)

  createdByStaffId String
  createdByStaff   HqStaff @relation(fields: [createdByStaffId], references: [id])

  // Push-to-apps/api sync state (arenaSync.ts) — surfaced on the contest
  // detail page so staff can see/retry a failed push rather than it silently
  // never reaching the runtime side.
  syncStatus ContestSyncStatus @default(idle)
  syncedAt   DateTime?
  syncError  String?

  // Final standings pushed back from apps/api once rating computation
  // finishes — read-only display, no need to be relational since nothing in
  // hq-api joins against it.
  resultsSnapshot Json?

  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions ContestQuestion[]

  @@index([status, startAt])
  @@map("contest")
}

model ContestQuestion {
  id         String            @id @default(cuid())
  contestId  String
  contest    Contest           @relation(fields: [contestId], references: [id], onDelete: Cascade)
  seq        Int
  type       ArenaQuestionType @default(coding)
  title      String
  bodyMd     String            @db.Text
  difficulty ArenaDifficulty
  points     Float             @default(100)
  // Optional markdown solution walkthrough — shown publicly once the
  // contest is "completed" (see apps/api's arenaContests.routes.ts).
  editorial  String?           @db.Text
  // AI Question Generator (services/aiQuestion.ts): staff can generate a
  // draft via Gemini before editing/saving it through the normal question
  // form — these two fields are purely provenance, never read by grading.
  generatedByAI Boolean @default(false)
  aiPromptUsed  String? @db.Text
  // Language allowlist + starter code + test cases as one JSON blob (not a
  // normalized TestCase table like apps/api's Question has) — deliberately,
  // since this whole object is what gets serialized verbatim into the sync
  // payload to apps/api; one blob to copy, no join to reconstruct.
  typeConfig Json            @default("{}")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([contestId, seq])
  @@map("contest_question")
}
